{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mb_emailhubdataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mb_emailhuboutlook"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_message_is_ready_for_Outlook": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "mb_emailmessage",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "mb_status"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@equals(triggerOutputs()?['body/mb_status'], 100000007)"
            }
          ]
        }
      },
      "actions": {
        "List_Settings": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "mb_emailsettings",
              "$filter": "mb_isactive eq true and statecode eq 0",
              "$orderby": "createdon asc",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "Get_Message": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "mb_emailmessages",
              "recordId": "@triggerOutputs()?['body/mb_emailmessageid']",
              "$select": "mb_importance,mb_fromaddress"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "List_Settings": [
              "Succeeded"
            ]
          }
        },
        "Settings": {
          "type": "Compose",
          "runAfter": {
            "Get_Message": [
              "Succeeded"
            ]
          },
          "inputs": {
            "shared": "@equals(coalesce(first(outputs('List_Settings')?['body/value'])?['mb_sendmode'], 100000000), 100000001)",
            "sharedMailbox": "@coalesce(outputs('Get_Message')?['body/mb_fromaddress'], first(outputs('List_Settings')?['body/value'])?['mb_sharedmailbox'], first(outputs('List_Settings')?['body/value'])?['mb_fromaddress'], '')",
            "sendFrom": "@coalesce(outputs('Get_Message')?['body/mb_fromaddress'], first(outputs('List_Settings')?['body/value'])?['mb_fromaddress'], '')",
            "replyTo": "@coalesce(first(outputs('List_Settings')?['body/value'])?['mb_replyto'], '')"
          }
        },
        "List_Pending_Deliveries": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "mb_emaildeliveries",
              "$select": "mb_emaildeliveryid,mb_toaddresses,mb_subjectsent,mb_bodysent,mb_ccaddresses,mb_bccaddresses",
              "$filter": "_mb_emailmessageid_value eq @{triggerOutputs()?['body/mb_emailmessageid']} and mb_deliverystatus eq 100000003 and mb_channel eq 100000000"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Settings": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 5000
            }
          }
        },
        "For_Each_Delivery": {
          "type": "Foreach",
          "runAfter": {
            "List_Pending_Deliveries": [
              "Succeeded"
            ]
          },
          "foreach": "@outputs('List_Pending_Deliveries')?['body/value']",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 5
            }
          },
          "actions": {
            "Use_Shared_Mailbox": {
              "type": "If",
              "runAfter": {},
              "expression": "@equals(outputs('Settings')?['shared'], true)",
              "actions": {
                "Send_Shared": {
                  "type": "Scope",
                  "runAfter": {},
                  "actions": {
                    "Send_Email_Shared": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_office365",
                          "operationId": "SharedMailboxSendEmailV2",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                        },
                        "parameters": {
                          "emailMessage/MailboxAddress": "@{outputs('Settings')?['sharedMailbox']}",
                          "emailMessage/To": "@{items('For_Each_Delivery')?['mb_toaddresses']}",
                          "emailMessage/Subject": "@{items('For_Each_Delivery')?['mb_subjectsent']}",
                          "emailMessage/Body": "@{items('For_Each_Delivery')?['mb_bodysent']}",
                          "emailMessage/Cc": "@if(empty(coalesce(items('For_Each_Delivery')?['mb_ccaddresses'],'')), null, items('For_Each_Delivery')?['mb_ccaddresses'])",
                          "emailMessage/Bcc": "@if(empty(coalesce(items('For_Each_Delivery')?['mb_bccaddresses'],'')), null, items('For_Each_Delivery')?['mb_bccaddresses'])",
                          "emailMessage/Importance": "@{coalesce(outputs('Get_Message')?['body/mb_importance@OData.Community.Display.V1.FormattedValue'], 'Normal')}",
                          "emailMessage/ReplyTo": "@if(empty(coalesce(outputs('Settings')?['replyTo'],'')), null, outputs('Settings')?['replyTo'])"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {}
                    }
                  }
                },
                "Mark_Sent_Shared": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "mb_emaildeliveries",
                      "recordId": "@items('For_Each_Delivery')?['mb_emaildeliveryid']",
                      "item/mb_deliverystatus": 100000000,
                      "item/mb_sentat": "@utcNow()"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Send_Shared": [
                      "Succeeded"
                    ]
                  }
                },
                "Mark_Failed_Shared": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "mb_emaildeliveries",
                      "recordId": "@items('For_Each_Delivery')?['mb_emaildeliveryid']",
                      "item/mb_deliverystatus": 100000001,
                      "item/mb_sentat": "@utcNow()",
                      "item/mb_errordetail": "@{take(coalesce(first(result('Send_Shared'))?['outputs']?['body']?['error']?['message'], first(result('Send_Shared'))?['outputs']?['body']?['message'], first(result('Send_Shared'))?['error']?['message'], 'The mail server rejected the message.'), 10000)}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Send_Shared": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Send_Owner": {
                    "type": "Scope",
                    "runAfter": {},
                    "actions": {
                      "Send_Email_Owner": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_office365",
                            "operationId": "SendEmailV2",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                          },
                          "parameters": {
                            "emailMessage/From": "@if(empty(coalesce(outputs('Settings')?['sendFrom'],'')), null, outputs('Settings')?['sendFrom'])",
                            "emailMessage/To": "@{items('For_Each_Delivery')?['mb_toaddresses']}",
                            "emailMessage/Subject": "@{items('For_Each_Delivery')?['mb_subjectsent']}",
                            "emailMessage/Body": "@{items('For_Each_Delivery')?['mb_bodysent']}",
                            "emailMessage/Cc": "@if(empty(coalesce(items('For_Each_Delivery')?['mb_ccaddresses'],'')), null, items('For_Each_Delivery')?['mb_ccaddresses'])",
                            "emailMessage/Bcc": "@if(empty(coalesce(items('For_Each_Delivery')?['mb_bccaddresses'],'')), null, items('For_Each_Delivery')?['mb_bccaddresses'])",
                            "emailMessage/Importance": "@{coalesce(outputs('Get_Message')?['body/mb_importance@OData.Community.Display.V1.FormattedValue'], 'Normal')}",
                            "emailMessage/ReplyTo": "@if(empty(coalesce(outputs('Settings')?['replyTo'],'')), null, outputs('Settings')?['replyTo'])"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "runAfter": {}
                      }
                    }
                  },
                  "Mark_Sent_Owner": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_commondataserviceforapps",
                        "operationId": "UpdateRecord",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "mb_emaildeliveries",
                        "recordId": "@items('For_Each_Delivery')?['mb_emaildeliveryid']",
                        "item/mb_deliverystatus": 100000000,
                        "item/mb_sentat": "@utcNow()"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {
                      "Send_Owner": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Mark_Failed_Owner": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_commondataserviceforapps",
                        "operationId": "UpdateRecord",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "mb_emaildeliveries",
                        "recordId": "@items('For_Each_Delivery')?['mb_emaildeliveryid']",
                        "item/mb_deliverystatus": 100000001,
                        "item/mb_sentat": "@utcNow()",
                        "item/mb_errordetail": "@{take(coalesce(first(result('Send_Owner'))?['outputs']?['body']?['error']?['message'], first(result('Send_Owner'))?['outputs']?['body']?['message'], first(result('Send_Owner'))?['error']?['message'], 'The mail server rejected the message.'), 10000)}"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {
                      "Send_Owner": [
                        "Failed",
                        "TimedOut"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}